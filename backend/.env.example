APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
THIRD_PARTY_LOG_LEVEL=debug
THIRD_PARTY_LOG_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AliExpress 速卖通API
ALIEXPRESS_BASE_URL=https://openapi.aliexpress.ru   # API基础地址
ALIEXPRESS_VERIFY_SSL=false                          # 是否验证SSL证书（本地开发可关闭）

# 中国邮政寄递平台
CHINAPOST_BASE_URL=https://211.156.197.248:443  # 接口地址（测试环境），正式环境需替换
CHINAPOST_EC_COMPANY_ID=APIBFABSX                        # 协议大客户号，如 90000003465705
CHINAPOST_AUTHORIZATION=UERzNcp0sdrNbVpA                        # 协议客户授权码（开放平台接口）
CHINAPOST_DIGEST_KEY=b2twaDl2ZUlCcDA3aE9CYw==                           # SM4密钥（通常为Base64字符串）
CHINAPOST_MAIL_TYPE=速卖通店群管理                            # 电商标识，对接时由"中邮API对接"注册
CHINAPOST_WH_CODE=                              # 揽收机构编号，从当地邮局获取，如 10000030
CHINAPOST_VERIFY_SSL=false                      # 是否验证SSL证书
CHINAPOST_API_CODE_CREATE_ORDER=110001          # 国际订单交运并返回邮件号 apiCode
CHINAPOST_API_CODE_ALLOCATE_BARCODE=110002      # 条码分配 apiCode
CHINAPOST_API_CODE_GET_LABEL=120001             # 获取面单 apiCode

# 中国邮政接口路径公共参数
CHINAPOST_PATH_OPEN_API=/amp-prod-api/f/amp/api/open
CHINAPOST_PATH_SURFACE_DOWNLOAD=/pcpErp-web/a/pcp/surface/download
CHINAPOST_PATH_CANCEL_ORDER=/pcpErp-web/a/pcp/orderService/cancelOrder
CHINAPOST_PATH_ORDER_FEE=/pcpErp-web/a/pcp/orderFeeService/getOrderFee

# 中国邮政报文公共参数
CHINAPOST_VERSION=2.0                           # 面单下载等接口版本
CHINAPOST_OPEN_VERSION=V1.0.0                   # 开放平台公共参数 version
CHINAPOST_OPEN_MSG_TYPE=0                       # 开放平台公共参数 msgType: 0-json, 1-xml
CHINAPOST_USER_CODE=                            # 开放平台公共参数 userCode（可选）
CHINAPOST_SEND_PRODUCT_TYPE=false               # 是否发送外层 productType
CHINAPOST_SEND_BIZ_PRODUCT_NO=false             # 是否发送外层 biz_product_no
CHINAPOST_PRODUCT_TYPE=E邮宝                   # 开放平台 productType
CHINAPOST_BIZ_PRODUCT_NO=019                    # 默认业务产品: 019=E邮宝
CHINAPOST_PAGE_TYPE=RM                          # 默认面单版式
CHINAPOST_LABEL_VERSION=2                       # 获取面单接口内部 version: 1=文件流, 2=base64
CHINAPOST_LABEL_AK=                             # 获取面单接口 AK
CHINAPOST_TRANSFER_TYPE=HK                      # 运输方式代码
CHINAPOST_BATTERY_FLAG=0                        # 是否带电: 0=否, 1=是
CHINAPOST_UNDELIVERY_OPTION=2                   # 无法投递处理方式
CHINAPOST_BACK_ADDR=                             # 退件地址
CHINAPOST_BACK_WAY=1                            # 退回方式: 1经济邮路, 2航空
CHINAPOST_DECLARE_SOURCE=2                      # 申报来源
CHINAPOST_DECLARE_TYPE=1                        # 申报类型
CHINAPOST_DECLARE_CURR_CODE=USD                 # 申报币种
CHINAPOST_FORECASTSHUT=0                        # 是否预报关
CHINAPOST_MAIL_SIGN=2                           # 邮件标识
CHINAPOST_MAIL_FLAG=0                           # 邮件类型
CHINAPOST_PRINTCODE=0                           # 打印格式
CHINAPOST_VALUABLE_FLAG=0                       # 贵品标识
CHINAPOST_INSURANCE_FLAG=                       # 保险保价标志: 1/2/3
CHINAPOST_ITEM_UNIT=个                          # 内件计量单位
CHINAPOST_BARCODE_LOGISTICS_COMPANY=POST        # 条码分配接口 logisticsCompany
CHINAPOST_BARCODE_FACE_TYPE=1                   # 条码分配接口 faceType

# 默认寄件人信息
CHINAPOST_SENDER_NAME=                          # 寄件人姓名
CHINAPOST_SENDER_COMPANY=                       # 寄件人公司
CHINAPOST_SENDER_POSTCODE=                      # 寄件人邮编
CHINAPOST_SENDER_PHONE=                         # 寄件人电话
CHINAPOST_SENDER_MOBILE=                        # 寄件人手机
CHINAPOST_SENDER_EMAIL=                         # 寄件人邮箱
CHINAPOST_SENDER_ID_TYPE=                       # 寄件人证件类型
CHINAPOST_SENDER_ID_NO=                         # 寄件人证件号码
CHINAPOST_SENDER_PROVINCE=                      # 寄件人省份
CHINAPOST_SENDER_CITY=                          # 寄件人城市
CHINAPOST_SENDER_COUNTY=                        # 寄件人区县
CHINAPOST_SENDER_ADDRESS=                       # 寄件人详细地址
CHINAPOST_SENDER_GIS=                           # 寄件人GIS坐标
CHINAPOST_SENDER_LINKER=                        # 寄件人联系人

