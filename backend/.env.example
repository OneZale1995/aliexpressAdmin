APP_NAME=AliExpressAdmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
THIRD_PARTY_LOG_LEVEL=debug
THIRD_PARTY_LOG_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aliexpress_admin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
#  第三方服务（连接参数、寄件人等均通过后台「系统配置」管理）
#  以下仅作为 config/services.php 的 fallback 默认值
#  正常部署无需填写，系统配置会优先覆盖
# ============================================================
ALIEXPRESS_BASE_URL=https://openapi.aliexpress.ru
ALIEXPRESS_VERIFY_SSL=false
