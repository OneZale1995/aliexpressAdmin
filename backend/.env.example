APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AliExpress 速卖通API
ALIEXPRESS_BASE_URL=https://openapi.aliexpress.ru   # API基础地址
ALIEXPRESS_VERIFY_SSL=false                          # 是否验证SSL证书（本地开发可关闭）

# 中国邮政寄递平台
CHINAPOST_BASE_URL=https://211.156.197.248:443  # 接口地址（测试环境），正式环境需替换
CHINAPOST_EC_COMPANY_ID=                        # 协议大客户号，如 90000003465705
CHINAPOST_DIGEST_KEY=                           # 接入密钥（用于签名）
CHINAPOST_MAIL_TYPE=                            # 电商标识，对接时由"中邮API对接"注册
CHINAPOST_WH_CODE=                              # 揽收机构编号，从当地邮局获取，如 10000030
CHINAPOST_VERIFY_SSL=false                      # 是否验证SSL证书
# 默认寄件人信息
CHINAPOST_SENDER_NAME=                          # 寄件人姓名
CHINAPOST_SENDER_COMPANY=                       # 寄件人公司
CHINAPOST_SENDER_POSTCODE=                      # 寄件人邮编
CHINAPOST_SENDER_PHONE=                         # 寄件人电话
CHINAPOST_SENDER_MOBILE=                        # 寄件人手机
CHINAPOST_SENDER_EMAIL=                         # 寄件人邮箱
CHINAPOST_SENDER_PROVINCE=                      # 寄件人省份
CHINAPOST_SENDER_CITY=                          # 寄件人城市
CHINAPOST_SENDER_COUNTY=                        # 寄件人区县
CHINAPOST_SENDER_ADDRESS=                       # 寄件人详细地址
CHINAPOST_SENDER_LINKER=                        # 寄件人联系人

# 雷翼/华磊 sz56t 货代系统
SZ56T_API_URL=http://www.sz56t.com:8082         # 创建订单API地址（测试环境，正式环境联系货代）
SZ56T_LABEL_URL=http://www.sz56t.com:8089       # 打印标签地址
SZ56T_USERNAME=                                  # 登录账号
SZ56T_PASSWORD=                                  # 登录密码
SZ56T_CUSTOMER_ID=                               # 客户ID（认证后自动获取，也可预填）
SZ56T_CUSTOMER_USERID=                           # 登录人ID（认证后自动获取，也可预填）
SZ56T_PRODUCT_ID=                                # 运输方式ID（从渠道列表获取）
SZ56T_TRADE_TYPE=ZYXT                            # 交易类型（ZYXT=客户自用系统）
